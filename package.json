{
  "name": "tarot-spark",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 && stylelint \"**/*.css\" --ignore-pattern \"node_modules/**\" --ignore-pattern \".next/**\" --ignore-pattern \"test-results/**\"",
    "docs:lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.corepack\" \"#.pnpm-store\" \"#test-results\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@measure-twice/react": "0.4.0",
    "next": "16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3",
    "stylelint": "^17.14.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4"
  }
}
