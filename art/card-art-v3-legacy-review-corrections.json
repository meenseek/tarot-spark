      "decisions": {
        "the-fool": {
          "previousDecision": "keep",
          "decision": "retouch",
          "reason": "Remove only the clipped floating star ornament at the top edge; preserve the traveler, dog, path, cliff, satchel and all other pixels outside the reviewed sky mask."
        },
        "the-lovers": {
          "previousDecision": "keep",
          "decision": "keep",
          "reason": "The mutual open-hand choice, personal space, joined paths and paired natural symbols remain distinct and readable at both review sizes."
        },
        "the-chariot": {
          "previousDecision": "keep",
          "decision": "keep",
          "reason": "The practical chariot, contrasting horse pair and controlled forward direction remain anatomically sound and immediately identifiable."
        },
        "strength": {
          "previousDecision": "keep",
          "decision": "keep",
          "reason": "The voluntary calm-lion interaction and gentle paw treatment clearly express courage without domination or anatomy defects."
        },
        "wheel-of-fortune": {
          "previousDecision": "keep",
          "decision": "replace",
          "reason": "The foreground road reads as a three-arm Y junction rather than the required four-way crossing, and the marked planning sheet weakens the dominant cycle-and-change scene."
        }
      },
