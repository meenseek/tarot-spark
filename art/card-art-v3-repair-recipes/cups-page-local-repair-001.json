    "clampOrder": "compute and clamp targetRed and targetBlue before solving and clamping targetGreen",
    "signedRounding": "roundDiv rounds halves away from zero; positive alpha-blend numerators round to nearest integer",
    "alphaBlend": "roundDiv(target*alpha + base*(255-alpha), 255); alpha=0 copies base channel byte-for-byte",
    "luminanceTolerance": "pixelLuminance(targetRed,targetGreen,targetBlue) differs from input luminance by at most 1"
  },
